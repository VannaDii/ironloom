{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated",
  "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
  "$ref": "#/$defs/ConfigurationSnapshotData",
  "$defs": {
    "ActorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ActorId value.",
      "type": "string",
      "minLength": 1
    },
    "BillingMode": {
      "description": "Explicit cost basis; no silent billing fallback.",
      "oneOf": [
        {
          "description": "API key billing.",
          "type": "string",
          "const": "api_key"
        },
        {
          "description": "Account-backed OAuth usage; not API-key charges.",
          "type": "string",
          "const": "account"
        },
        {
          "description": "Configured local compute cost estimate.",
          "type": "string",
          "const": "local_estimate"
        }
      ]
    },
    "ConfigurationSnapshotData": {
      "description": "Unchecked construction draft for `ConfigurationSnapshot`; validate before use.",
      "type": "object",
      "properties": {
        "device_preferences": {
          "description": "Explicit enable/disable settings.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Validated5"
          }
        },
        "discovered_devices": {
          "description": "Server-resolved device identities; simulations remain unqualified.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Validated6"
          }
        },
        "execution_ready": {
          "description": "Execution readiness independent of functioning setup/web readiness.",
          "type": "boolean"
        },
        "models": {
          "description": "Human-selected model profiles visible to this account.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Validated3"
          }
        },
        "project_id": {
          "description": "Installation or project settings scope.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "description": "Durable configuration revision for subsequent mutations.",
          "$ref": "#/$defs/Counter"
        },
        "roles": {
          "description": "Configured team, including orchestration.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Validated2"
          }
        },
        "setup": {
          "description": "Absent until required lesson handling and delivery mode have been saved.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validated"
            },
            {
              "type": "null"
            }
          ]
        },
        "unmet_prerequisites": {
          "description": "Visible configuration/capability/permission blockers.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "roles",
        "models",
        "device_preferences",
        "discovered_devices",
        "execution_ready",
        "unmet_prerequisites"
      ]
    },
    "Counter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Canonical decimal u64; semantic validation also enforces u64 maximum.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "CredentialId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom CredentialId value.",
      "type": "string",
      "minLength": 1
    },
    "DeviceId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom DeviceId value.",
      "type": "string",
      "minLength": 1
    },
    "DeviceIdentityData": {
      "description": "Unchecked construction draft for `DeviceIdentity`; validate before use.",
      "type": "object",
      "properties": {
        "device_id": {
          "description": "Canonical capacity pool identity reconciled across views.",
          "$ref": "#/$defs/DeviceId"
        },
        "hardware_key": {
          "description": "Vendor UUID or reconciled host-scoped hardware identity.",
          "$ref": "#/$defs/ActorId"
        },
        "host_id": {
          "description": "Physical host identity distinct from node ID.",
          "$ref": "#/$defs/HostId"
        },
        "parent_id": {
          "description": "Parent physical GPU for partition/virtual views.",
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "reconciled": {
          "description": "False blocks admission; ordinals never establish identity.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "device_id",
        "host_id",
        "hardware_key",
        "reconciled"
      ]
    },
    "DevicePreferenceData": {
      "description": "Unchecked construction draft for `DevicePreference`; validate before use.",
      "type": "object",
      "properties": {
        "device_id": {
          "description": "Desired canonical device, resolved against service discovery records.",
          "$ref": "#/$defs/DeviceId"
        },
        "enabled": {
          "description": "Explicit operator enable/disable choice; never capacity authority.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "device_id",
        "enabled"
      ]
    },
    "EngineIdentityData": {
      "description": "Unchecked construction draft for `EngineIdentity`; validate before use.",
      "type": "object",
      "properties": {
        "backend": {
          "description": "Selected accelerator backend.",
          "$ref": "#/$defs/ActorId"
        },
        "configuration_hash": {
          "description": "Engine configuration identity.",
          "$ref": "#/$defs/ActorId"
        },
        "name": {
          "description": "Explicit selected engine, never silently substituted.",
          "$ref": "#/$defs/ActorId"
        },
        "version": {
          "description": "Pinned version.",
          "$ref": "#/$defs/ActorId"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "backend",
        "configuration_hash"
      ]
    },
    "FactorySetupData": {
      "description": "Unchecked construction draft for `FactorySetup`; validate before use.",
      "type": "object",
      "properties": {
        "delivery_confirmed": {
          "description": "Human explicitly confirmed delivery authority.",
          "type": "boolean"
        },
        "deploy": {
          "description": "Explicit deployment authority.",
          "type": "boolean"
        },
        "lesson_handling": {
          "description": "Explicitly saved lesson handling choice.",
          "$ref": "#/$defs/LessonHandling"
        },
        "merge": {
          "description": "Explicit merge authority.",
          "type": "boolean"
        },
        "publish_branch": {
          "description": "Confirmed permission to publish a branch and PR.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "lesson_handling",
        "delivery_confirmed",
        "publish_branch",
        "merge",
        "deploy"
      ]
    },
    "HostId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom HostId value.",
      "type": "string",
      "minLength": 1
    },
    "InstructionId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom InstructionId value.",
      "type": "string",
      "minLength": 1
    },
    "LessonHandling": {
      "description": "Required explicit setup choice; no implicit default.",
      "oneOf": [
        {
          "description": "Share new lessons only with sufficient share authority.",
          "type": "string",
          "const": "share_across_projects"
        },
        {
          "description": "Apply immediately in origin project; no broader sharing.",
          "type": "string",
          "const": "project_only"
        },
        {
          "description": "Apply immediately in origin; retain for later promotion or pruning.",
          "type": "string",
          "const": "track_for_review"
        }
      ]
    },
    "ModelProfileConfigurationData": {
      "description": "Unchecked construction draft for `ModelProfileConfiguration`; validate before use.",
      "type": "object",
      "properties": {
        "billing": {
          "description": "Explicit account/API/local estimate billing choice.",
          "$ref": "#/$defs/BillingMode"
        },
        "credential_id": {
          "description": "Private credential reference; separate use/share/replace/delete grants.",
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialId"
            },
            {
              "type": "null"
            }
          ]
        },
        "device_bindings": {
          "description": "Desired configured local devices; discovery and admission recheck identity.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeviceId"
          }
        },
        "engine": {
          "description": "Explicit local engine/version/backend; no default engine fallback.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validated4"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_id": {
          "description": "Configured provider model/checkpoint.",
          "$ref": "#/$defs/ActorId"
        },
        "profile_id": {
          "description": "Stable human-selected profile identity.",
          "$ref": "#/$defs/ModelProfileId"
        },
        "provider": {
          "description": "Explicit provider; no silent substitute.",
          "$ref": "#/$defs/ActorId"
        }
      },
      "additionalProperties": false,
      "required": [
        "profile_id",
        "provider",
        "model_id",
        "billing",
        "device_bindings"
      ]
    },
    "ModelProfileId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ModelProfileId value.",
      "type": "string",
      "minLength": 1
    },
    "ProjectId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ProjectId value.",
      "type": "string",
      "minLength": 1
    },
    "RoleConfigurationData": {
      "description": "Unchecked construction draft for `RoleConfiguration`; validate before use.",
      "type": "object",
      "properties": {
        "device_bindings": {
          "description": "Optional role device restrictions, intersected with its model profile placement.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeviceId"
          }
        },
        "enabled": {
          "description": "Disabled roles do not dispatch.",
          "type": "boolean"
        },
        "instructions_id": {
          "description": "Template copied into assignments.",
          "$ref": "#/$defs/InstructionId"
        },
        "model_profile_id": {
          "description": "Explicit human-selected model; no implicit default.",
          "anyOf": [
            {
              "$ref": "#/$defs/ModelProfileId"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning_applicable": {
          "description": "Selected model supports reasoning effort.",
          "type": "boolean"
        },
        "reasoning_effort": {
          "description": "Explicit human choice where applicable.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "role_id": {
          "description": "Editable standard or custom role identity.",
          "$ref": "#/$defs/ActorId"
        }
      },
      "additionalProperties": false,
      "required": [
        "role_id",
        "enabled",
        "reasoning_applicable",
        "device_bindings",
        "instructions_id"
      ]
    },
    "Validated": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/FactorySetupData"
    },
    "Validated2": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/RoleConfigurationData"
    },
    "Validated3": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/ModelProfileConfigurationData"
    },
    "Validated4": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/EngineIdentityData"
    },
    "Validated5": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/DevicePreferenceData"
    },
    "Validated6": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/DeviceIdentityData"
    }
  }
}
