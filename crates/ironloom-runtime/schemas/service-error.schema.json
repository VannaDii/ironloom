{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceError",
  "description": "Safe public service errors; no internal SQL, arguments or secrets.",
  "oneOf": [
    {
      "description": "Typed request invalid.",
      "type": "object",
      "properties": {
        "validation": {
          "$ref": "#/$defs/ValidationErrors"
        }
      },
      "additionalProperties": false,
      "required": [
        "validation"
      ]
    },
    {
      "description": "Missing or stale authentication/authority.",
      "type": "object",
      "properties": {
        "authentication": {
          "$ref": "#/$defs/AuthenticationError"
        }
      },
      "additionalProperties": false,
      "required": [
        "authentication"
      ]
    },
    {
      "description": "Same command identity with changed payload or stale revision.",
      "type": "string",
      "const": "conflict"
    },
    {
      "description": "Requested history no longer retained; fetch snapshot before reconnect.",
      "type": "string",
      "const": "cursor_expired"
    },
    {
      "description": "Dependencies unavailable; never initialize replacement state.",
      "type": "string",
      "const": "unavailable"
    }
  ],
  "$defs": {
    "AuthenticationError": {
      "description": "Fail-closed authentication outcome.",
      "oneOf": [
        {
          "description": "No valid session.",
          "type": "string",
          "const": "unauthenticated"
        },
        {
          "description": "Identity lacks current authority.",
          "type": "string",
          "const": "forbidden"
        },
        {
          "description": "Bootstrap already has its sole administrator.",
          "type": "string",
          "const": "bootstrap_consumed"
        },
        {
          "description": "Invalid local or OIDC proof; no secret details.",
          "type": "string",
          "const": "invalid_credentials"
        },
        {
          "description": "Storage or authentication unavailable; do not reset identity.",
          "type": "string",
          "const": "unavailable"
        }
      ]
    },
    "FieldError": {
      "description": "Redacted validation failure at a model field, without submitted values.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable machine-readable reason; never a raw parser error.",
          "type": "string"
        },
        "field": {
          "description": "Dot-separated field path, including nested fields.",
          "type": "string"
        }
      },
      "required": [
        "field",
        "code"
      ]
    },
    "ValidationErrors": {
      "description": "Structured errors safe to return to clients.",
      "type": "object",
      "properties": {
        "fields": {
          "description": "Independent field failures.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        }
      },
      "required": [
        "fields"
      ]
    }
  }
}
