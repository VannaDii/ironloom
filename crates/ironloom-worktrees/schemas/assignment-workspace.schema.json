{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated",
  "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
  "$ref": "#/$defs/AssignmentWorkspaceData",
  "$defs": {
    "ActorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ActorId value.",
      "type": "string",
      "minLength": 1
    },
    "AssignmentId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom AssignmentId value.",
      "type": "string",
      "minLength": 1
    },
    "AssignmentWorkspaceData": {
      "description": "Unchecked construction draft for `AssignmentWorkspace`; validate before use.",
      "type": "object",
      "properties": {
        "assignment_id": {
          "description": "One shared worktree per assignment.",
          "$ref": "#/$defs/AssignmentId"
        },
        "base_revision": {
          "description": "Exact source revision.",
          "$ref": "#/$defs/ActorId"
        },
        "branch": {
          "description": "Assignment branch.",
          "$ref": "#/$defs/BranchName"
        },
        "mutation_fence": {
          "description": "Coordinated Git owner token.",
          "$ref": "#/$defs/Counter"
        },
        "owner_node": {
          "description": "Tools route to this node; metadata sharing is not file sharing.",
          "$ref": "#/$defs/NodeId"
        },
        "project_id": {
          "description": "Stable project, independent of display name.",
          "$ref": "#/$defs/ProjectId"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "assignment_id",
        "owner_node",
        "branch",
        "base_revision",
        "mutation_fence"
      ]
    },
    "BranchName": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Git branch reference.",
      "type": "string",
      "minLength": 1
    },
    "Counter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Canonical decimal u64; semantic validation also enforces u64 maximum.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "NodeId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom NodeId value.",
      "type": "string",
      "minLength": 1
    },
    "ProjectId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ProjectId value.",
      "type": "string",
      "minLength": 1
    }
  }
}
