{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated",
  "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
  "$ref": "#/$defs/NativeEnrollmentData",
  "$defs": {
    "ActorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ActorId value.",
      "type": "string",
      "minLength": 1
    },
    "Counter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Canonical decimal u64; semantic validation also enforces u64 maximum.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "CredentialId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom CredentialId value.",
      "type": "string",
      "minLength": 1
    },
    "InstallationId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom InstallationId value.",
      "type": "string",
      "minLength": 1
    },
    "NativeEnrollmentData": {
      "description": "Unchecked construction draft for `NativeEnrollment`; validate before use.",
      "type": "object",
      "properties": {
        "authentication_generation": {
          "description": "Reject stale token-refresh results.",
          "$ref": "#/$defs/Counter"
        },
        "control_registration_ref": {
          "description": "Protected imported control registration.",
          "$ref": "#/$defs/CredentialId"
        },
        "enabled": {
          "description": "Persisted user preference.",
          "type": "boolean"
        },
        "external_account_id": {
          "description": "Connected external account.",
          "$ref": "#/$defs/ActorId"
        },
        "inference_credential_ref": {
          "description": "Separate eligible inference credentials; no billing fallback.",
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialId"
            },
            {
              "type": "null"
            }
          ]
        },
        "installation_id": {
          "description": "Existing shared installation.",
          "$ref": "#/$defs/InstallationId"
        },
        "node_id": {
          "description": "Enrolled service node.",
          "$ref": "#/$defs/NodeId"
        },
        "operator_id": {
          "description": "Authorized human mapping; host does not grant access.",
          "$ref": "#/$defs/OperatorId"
        },
        "server_environment_id": {
          "description": "Native server/environment mapping.",
          "$ref": "#/$defs/ActorId"
        }
      },
      "additionalProperties": false,
      "required": [
        "installation_id",
        "node_id",
        "server_environment_id",
        "external_account_id",
        "operator_id",
        "enabled",
        "authentication_generation",
        "control_registration_ref"
      ]
    },
    "NodeId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom NodeId value.",
      "type": "string",
      "minLength": 1
    },
    "OperatorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom OperatorId value.",
      "type": "string",
      "minLength": 1
    }
  }
}
