{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated",
  "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
  "$ref": "#/$defs/DeviceResourceObservationData",
  "$defs": {
    "Counter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Canonical decimal u64; semantic validation also enforces u64 maximum.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "DeviceId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom DeviceId value.",
      "type": "string",
      "minLength": 1
    },
    "DeviceResourceObservationData": {
      "description": "Unchecked construction draft for `DeviceResourceObservation`; validate before use.",
      "type": "object",
      "properties": {
        "device_id": {
          "description": "Canonical device identity, not container ordinal.",
          "$ref": "#/$defs/DeviceId"
        },
        "external_used_bytes": {
          "description": "External pressure if separately known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at_ms": {
          "description": "Observation timestamp; not a reservation or lease.",
          "$ref": "#/$defs/Counter"
        },
        "total_bytes": {
          "description": "Observed capacity; absence is unknown.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "used_bytes": {
          "description": "Observed total pressure, including external consumers.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "device_id",
        "observed_at_ms"
      ]
    }
  }
}
