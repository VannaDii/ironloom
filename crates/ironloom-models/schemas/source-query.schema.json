{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated",
  "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
  "$ref": "#/$defs/SourceQueryData",
  "$defs": {
    "ActorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ActorId value.",
      "type": "string",
      "minLength": 1
    },
    "Counter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Canonical decimal u64; semantic validation also enforces u64 maximum.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "SourceQueryData": {
      "description": "Unchecked construction draft for `SourceQuery`; validate before use.",
      "type": "object",
      "properties": {
        "after": {
          "description": "Opaque source continuation token scoped to this query and account.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "description": "Optional hosting source filter, distinct from publisher.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "description": "Bounded discovery page size.",
          "$ref": "#/$defs/Counter"
        },
        "publisher": {
          "description": "Optional original publisher filter.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "query": {
          "description": "Search text; empty text browses the source catalog.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "query",
        "limit"
      ]
    }
  }
}
