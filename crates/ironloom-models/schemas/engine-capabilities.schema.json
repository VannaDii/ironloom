{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated",
  "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
  "$ref": "#/$defs/EngineCapabilitiesData",
  "$defs": {
    "ActorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ActorId value.",
      "type": "string",
      "minLength": 1
    },
    "CapabilitySupport": {
      "description": "Explicit optional capability status; unknown is distinct from unsupported.",
      "oneOf": [
        {
          "description": "Supported by this engine/version/backend.",
          "type": "string",
          "const": "supported"
        },
        {
          "description": "Known absent; do not invent an adaptation.",
          "type": "string",
          "const": "unsupported"
        },
        {
          "description": "Insufficient metadata; no inference capability probe.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "Counter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Canonical decimal u64; semantic validation also enforces u64 maximum.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "EngineCapabilitiesData": {
      "description": "Unchecked construction draft for `EngineCapabilities`; validate before use.",
      "type": "object",
      "properties": {
        "accelerators": {
          "description": "Additional accelerator requirements.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorId"
          }
        },
        "architectures": {
          "description": "Supported model architectures.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorId"
          }
        },
        "batching": {
          "description": "Concurrent request capability.",
          "$ref": "#/$defs/CapabilitySupport"
        },
        "context_cache": {
          "description": "Request-scoped cache support.",
          "$ref": "#/$defs/CapabilitySupport"
        },
        "draft_models": {
          "description": "Speculative decoding with explicit paired requirements.",
          "$ref": "#/$defs/CapabilitySupport"
        },
        "engine": {
          "description": "Selected exact engine/version/backend.",
          "$ref": "#/$defs/Validated"
        },
        "formats": {
          "description": "Supported weight formats.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorId"
          }
        },
        "max_context_tokens": {
          "description": "Known hard context bound; None is unknown.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "multi_gpu": {
          "description": "Coordinated placements supported.",
          "$ref": "#/$defs/CapabilitySupport"
        },
        "quantizations": {
          "description": "Supported quantizations.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorId"
          }
        },
        "streaming": {
          "description": "Incremental output available.",
          "type": "boolean"
        },
        "tools": {
          "description": "Tool-call generation supported; never execution.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "engine",
        "architectures",
        "formats",
        "quantizations",
        "streaming",
        "tools",
        "draft_models",
        "context_cache",
        "batching",
        "multi_gpu",
        "accelerators"
      ]
    },
    "EngineIdentityData": {
      "description": "Unchecked construction draft for `EngineIdentity`; validate before use.",
      "type": "object",
      "properties": {
        "backend": {
          "description": "Selected accelerator backend.",
          "$ref": "#/$defs/ActorId"
        },
        "configuration_hash": {
          "description": "Engine configuration identity.",
          "$ref": "#/$defs/ActorId"
        },
        "name": {
          "description": "Explicit selected engine, never silently substituted.",
          "$ref": "#/$defs/ActorId"
        },
        "version": {
          "description": "Pinned version.",
          "$ref": "#/$defs/ActorId"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "backend",
        "configuration_hash"
      ]
    },
    "Validated": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/EngineIdentityData"
    }
  }
}
