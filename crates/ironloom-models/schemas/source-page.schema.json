{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated",
  "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
  "$ref": "#/$defs/SourcePageData",
  "$defs": {
    "ActorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ActorId value.",
      "type": "string",
      "minLength": 1
    },
    "Counter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Canonical decimal u64; semantic validation also enforces u64 maximum.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "ModelCardData": {
      "description": "Unchecked construction draft for `ModelCard`; validate before use.",
      "type": "object",
      "properties": {
        "architecture": {
          "description": "Unknown when unavailable.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_tokens": {
          "description": "Source-declared context bound when known; not backend qualification.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "description": "Known weights format.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_id": {
          "description": "Model identity within its source.",
          "$ref": "#/$defs/ActorId"
        },
        "quantization": {
          "description": "Known weight quantization.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository_id": {
          "description": "Stable source repository identity used by metadata/download operations.",
          "$ref": "#/$defs/ActorId"
        },
        "source": {
          "description": "Publisher/host/revision/license/access provenance.",
          "$ref": "#/$defs/Validated2"
        },
        "weight_bytes": {
          "description": "Download/weights size when known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository_id",
        "model_id",
        "source"
      ]
    },
    "ModelSourceData": {
      "description": "Unchecked construction draft for `ModelSource`; validate before use.",
      "type": "object",
      "properties": {
        "access": {
          "description": "Current source-specific access.",
          "$ref": "#/$defs/SourceAccess"
        },
        "checksum": {
          "description": "Verified download/manifest hash.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "description": "Hosting hub/distribution.",
          "$ref": "#/$defs/ActorId"
        },
        "license": {
          "description": "License metadata; not automatic acceptance.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "publisher": {
          "description": "Original publisher distinct from host.",
          "$ref": "#/$defs/ActorId"
        },
        "repository_url": {
          "description": "Human access and license page.",
          "type": "string"
        },
        "revision": {
          "description": "Exact source revision.",
          "$ref": "#/$defs/ActorId"
        }
      },
      "additionalProperties": false,
      "required": [
        "publisher",
        "host",
        "repository_url",
        "revision",
        "access"
      ]
    },
    "SourceAccess": {
      "description": "Source access distinct from compatibility/fit/qualification.",
      "oneOf": [
        {
          "description": "Download permitted subject to current access recheck.",
          "type": "string",
          "const": "accessible"
        },
        {
          "description": "Connect source account.",
          "type": "string",
          "const": "authentication_required"
        },
        {
          "description": "Human follows repository link to request access.",
          "type": "string",
          "const": "terms_required"
        },
        {
          "description": "Recheck access; download stays disabled.",
          "type": "string",
          "const": "awaiting_approval"
        },
        {
          "description": "Access denied or revoked.",
          "type": "string",
          "const": "denied"
        }
      ]
    },
    "SourcePageData": {
      "description": "Unchecked construction draft for `SourcePage`; validate before use.",
      "type": "object",
      "properties": {
        "models": {
          "description": "Bounded source results, without losing provenance or access state.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Validated"
          }
        },
        "next_after": {
          "description": "Opaque continuation token for the same query/account; None ends pagination.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "models"
      ]
    },
    "Validated": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/ModelCardData"
    },
    "Validated2": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/ModelSourceData"
    }
  }
}
