{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated",
  "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
  "$ref": "#/$defs/ModelProfileConfigurationData",
  "$defs": {
    "ActorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ActorId value.",
      "type": "string",
      "minLength": 1
    },
    "BillingMode": {
      "description": "Explicit cost basis; no silent billing fallback.",
      "oneOf": [
        {
          "description": "API key billing.",
          "type": "string",
          "const": "api_key"
        },
        {
          "description": "Account-backed OAuth usage; not API-key charges.",
          "type": "string",
          "const": "account"
        },
        {
          "description": "Configured local compute cost estimate.",
          "type": "string",
          "const": "local_estimate"
        }
      ]
    },
    "ContextCacheData": {
      "description": "Unchecked construction draft for `ContextCache`; validate before use.",
      "type": "object",
      "properties": {
        "cache_id": {
          "description": "Request/session-scoped cache identity, separate from resident weights.",
          "$ref": "#/$defs/ActorId"
        },
        "capacity_bytes": {
          "description": "Configured bound if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "conversation_id": {
          "description": "Authorized conversation boundary; sharing weights does not share this context.",
          "$ref": "#/$defs/ConversationId"
        },
        "owner": {
          "description": "Authorized human scope; resolve independently at dispatch.",
          "$ref": "#/$defs/OperatorId"
        }
      },
      "additionalProperties": false,
      "required": [
        "cache_id",
        "conversation_id",
        "owner"
      ]
    },
    "ConversationId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ConversationId value.",
      "type": "string",
      "minLength": 1
    },
    "Counter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Canonical decimal u64; semantic validation also enforces u64 maximum.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "CredentialId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom CredentialId value.",
      "type": "string",
      "minLength": 1
    },
    "DeviceId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom DeviceId value.",
      "type": "string",
      "minLength": 1
    },
    "DraftModelData": {
      "description": "Unchecked construction draft for `DraftModel`; validate before use.",
      "type": "object",
      "properties": {
        "checkpoint_hash": {
          "description": "Verified draft manifest hash.",
          "$ref": "#/$defs/ActorId"
        },
        "model_id": {
          "description": "Explicit optional draft checkpoint, never a fallback target.",
          "$ref": "#/$defs/ActorId"
        },
        "quantization": {
          "description": "Draft quantization where applicable.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "description": "Exact draft revision.",
          "$ref": "#/$defs/ActorId"
        },
        "weight_bytes": {
          "description": "Draft memory estimate; unknown is not zero.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "model_id",
        "revision",
        "checkpoint_hash"
      ]
    },
    "EngineIdentityData": {
      "description": "Unchecked construction draft for `EngineIdentity`; validate before use.",
      "type": "object",
      "properties": {
        "backend": {
          "description": "Selected accelerator backend.",
          "$ref": "#/$defs/ActorId"
        },
        "configuration_hash": {
          "description": "Engine configuration identity.",
          "$ref": "#/$defs/ActorId"
        },
        "name": {
          "description": "Explicit selected engine, never silently substituted.",
          "$ref": "#/$defs/ActorId"
        },
        "version": {
          "description": "Pinned version.",
          "$ref": "#/$defs/ActorId"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "backend",
        "configuration_hash"
      ]
    },
    "EngineLoadOptionsData": {
      "description": "Unchecked construction draft for `EngineLoadOptions`; validate before use.",
      "type": "object",
      "properties": {
        "accelerators": {
          "description": "Explicit additional accelerators; engine may report unsupported.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorId"
          }
        },
        "cache": {
          "description": "Optional isolated context cache; absence does not imply cross-session reuse.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validated6"
            },
            {
              "type": "null"
            }
          ]
        },
        "concurrency": {
          "description": "Configured concurrent demand.",
          "$ref": "#/$defs/Counter"
        },
        "context_tokens": {
          "description": "Configured context demand for estimates/admission.",
          "$ref": "#/$defs/Counter"
        },
        "draft": {
          "description": "Explicit optional draft model.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validated5"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "context_tokens",
        "concurrency",
        "accelerators"
      ]
    },
    "GenerationControlsData": {
      "description": "Unchecked construction draft for `GenerationControls`; validate before use.",
      "type": "object",
      "properties": {
        "max_duration_ms": {
          "description": "Runaway bound.",
          "$ref": "#/$defs/Counter"
        },
        "max_output_tokens": {
          "description": "Generation bound independent of monetary budget.",
          "$ref": "#/$defs/Counter"
        },
        "repetition_window": {
          "description": "Incremental monitoring window; unavailable on nonstreaming engines.",
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "max_output_tokens",
        "max_duration_ms",
        "repetition_window"
      ]
    },
    "LocalModelBindingData": {
      "description": "Unchecked construction draft for `LocalModelBinding`; validate before use.",
      "type": "object",
      "properties": {
        "inventory_id": {
          "description": "Service-owned pinned inventory identity; runtime rechecks integrity and source access.",
          "$ref": "#/$defs/ActorId"
        },
        "options": {
          "description": "Explicit context/concurrency/draft/cache/accelerator settings; unsupported remains visible.",
          "$ref": "#/$defs/Validated4"
        },
        "template": {
          "description": "Explicit template, or None when embedded/not applicable.",
          "type": [
            "string",
            "null"
          ]
        },
        "tokenizer": {
          "description": "Explicit tokenizer, or None when embedded/not applicable.",
          "type": [
            "string",
            "null"
          ]
        },
        "weights": {
          "description": "Exact weight files relative to that installation root, including every selected shard.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "inventory_id",
        "weights",
        "options"
      ]
    },
    "ModelProfileConfigurationData": {
      "description": "Unchecked construction draft for `ModelProfileConfiguration`; validate before use.",
      "type": "object",
      "properties": {
        "billing": {
          "description": "Explicit account/API/local estimate billing choice.",
          "$ref": "#/$defs/BillingMode"
        },
        "credential_id": {
          "description": "Private credential reference; separate use/share/replace/delete grants.",
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialId"
            },
            {
              "type": "null"
            }
          ]
        },
        "device_bindings": {
          "description": "Desired configured local devices; discovery and admission recheck identity.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeviceId"
          }
        },
        "engine": {
          "description": "Explicit local engine/version/backend; no default engine fallback.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validated2"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation_controls": {
          "description": "Explicit generation bounds, independent of optional monetary budgets.",
          "$ref": "#/$defs/Validated"
        },
        "local_binding": {
          "description": "Explicit verified installation/file/options selection for local execution. None retains\nincomplete configuration and blocks local readiness; no first-file selection is inferred.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validated3"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_id": {
          "description": "Configured provider model/checkpoint.",
          "$ref": "#/$defs/ActorId"
        },
        "profile_id": {
          "description": "Stable human-selected profile identity.",
          "$ref": "#/$defs/ModelProfileId"
        },
        "provider": {
          "description": "Explicit provider; no silent substitute.",
          "$ref": "#/$defs/ActorId"
        }
      },
      "additionalProperties": false,
      "required": [
        "profile_id",
        "provider",
        "model_id",
        "generation_controls",
        "billing",
        "device_bindings"
      ]
    },
    "ModelProfileId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ModelProfileId value.",
      "type": "string",
      "minLength": 1
    },
    "OperatorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom OperatorId value.",
      "type": "string",
      "minLength": 1
    },
    "Validated": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/GenerationControlsData"
    },
    "Validated2": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/EngineIdentityData"
    },
    "Validated3": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/LocalModelBindingData"
    },
    "Validated4": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/EngineLoadOptionsData"
    },
    "Validated5": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/DraftModelData"
    },
    "Validated6": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/ContextCacheData"
    }
  }
}
