{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated",
  "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
  "$ref": "#/$defs/CredentialSummaryData",
  "$defs": {
    "ActorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ActorId value.",
      "type": "string",
      "minLength": 1
    },
    "Counter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Canonical decimal u64; semantic validation also enforces u64 maximum.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "CredentialId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom CredentialId value.",
      "type": "string",
      "minLength": 1
    },
    "CredentialSummaryData": {
      "description": "Unchecked construction draft for `CredentialSummary`; validate before use.",
      "type": "object",
      "properties": {
        "credential_id": {
          "description": "Opaque reference safe for authorized selection.",
          "$ref": "#/$defs/CredentialId"
        },
        "label": {
          "description": "Nonsecret human label.",
          "$ref": "#/$defs/ActorId"
        },
        "owner": {
          "description": "Private owner.",
          "$ref": "#/$defs/OperatorId"
        },
        "permissions": {
          "description": "Current operation-specific effective grants; no plaintext secret.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Permission"
          }
        },
        "revision": {
          "description": "Current management revision.",
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "credential_id",
        "owner",
        "label",
        "revision",
        "permissions"
      ]
    },
    "OperatorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom OperatorId value.",
      "type": "string",
      "minLength": 1
    },
    "Permission": {
      "description": "Resource grant; administrator identity alone grants no project content access.",
      "oneOf": [
        {
          "description": "Read approved resource content.",
          "type": "string",
          "const": "view"
        },
        {
          "description": "Dispatch within approved scope.",
          "type": "string",
          "const": "operate"
        },
        {
          "description": "Approve a plan revision.",
          "type": "string",
          "const": "approve"
        },
        {
          "description": "Manage membership or content.",
          "type": "string",
          "const": "manage"
        },
        {
          "description": "Broaden visibility explicitly.",
          "type": "string",
          "const": "share"
        },
        {
          "description": "Use through a trusted adapter.",
          "type": "string",
          "const": "use_credential"
        },
        {
          "description": "Replace secret material.",
          "type": "string",
          "const": "replace_credential"
        },
        {
          "description": "Delete secret material.",
          "type": "string",
          "const": "delete_credential"
        },
        {
          "description": "Enroll another service node.",
          "type": "string",
          "const": "enroll_node"
        },
        {
          "description": "Record administrator access to a private project.",
          "type": "string",
          "const": "self_grant"
        }
      ]
    }
  }
}
