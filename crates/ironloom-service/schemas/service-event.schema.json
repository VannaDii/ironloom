{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated",
  "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
  "$ref": "#/$defs/ServiceEventData",
  "$defs": {
    "ActorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ActorId value.",
      "type": "string",
      "minLength": 1
    },
    "AnswerId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom AnswerId value.",
      "type": "string",
      "minLength": 1
    },
    "AssignmentId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom AssignmentId value.",
      "type": "string",
      "minLength": 1
    },
    "BillingMode": {
      "description": "Explicit cost basis; no silent billing fallback.",
      "oneOf": [
        {
          "description": "API key billing.",
          "type": "string",
          "const": "api_key"
        },
        {
          "description": "Account-backed OAuth usage; not API-key charges.",
          "type": "string",
          "const": "account"
        },
        {
          "description": "Configured local compute cost estimate.",
          "type": "string",
          "const": "local_estimate"
        }
      ]
    },
    "BudgetData": {
      "description": "Unchecked construction draft for `Budget`; validate before use.",
      "type": "object",
      "properties": {
        "currency": {
          "description": "Budget currency.",
          "$ref": "#/$defs/ActorId"
        },
        "incurred_micros": {
          "description": "Already accounted charges.",
          "$ref": "#/$defs/Counter"
        },
        "limit_micros": {
          "description": "None disables budget, not usage accounting.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "reserved_micros": {
          "description": "Concurrent in-flight exposure.",
          "$ref": "#/$defs/Counter"
        },
        "revision": {
          "description": "Editable without changing plan approval.",
          "$ref": "#/$defs/Counter"
        },
        "uncertain_usage": {
          "description": "Unknown usage remains visible and constrains admission.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "currency",
        "incurred_micros",
        "reserved_micros",
        "uncertain_usage"
      ]
    },
    "CommandId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom CommandId value.",
      "type": "string",
      "minLength": 1
    },
    "ConversationId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ConversationId value.",
      "type": "string",
      "minLength": 1
    },
    "ConversationSnapshotData": {
      "description": "Unchecked construction draft for `ConversationSnapshot`; validate before use.",
      "type": "object",
      "properties": {
        "active_assignment_id": {
          "description": "Current assignment binding for reconnect controls; absent for an empty/idle conversation.",
          "anyOf": [
            {
              "$ref": "#/$defs/AssignmentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval": {
          "description": "Approval only for the exact visible plan, if approved.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validated7"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget": {
          "description": "Current budget independent of plan approval.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validated9"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "description": "Durable watermark of this consistent snapshot.",
          "$ref": "#/$defs/Validated"
        },
        "execution_state": {
          "description": "Current execution state; absence means no active assignment.",
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionState"
            },
            {
              "type": "null"
            }
          ]
        },
        "pause_requested": {
          "description": "Present for an active assignment; true requests a pause still awaiting a safe boundary.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "pending_questions": {
          "description": "Unresolved questions as of the same watermark.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Validated8"
          }
        },
        "plan": {
          "description": "Current visible plan revision.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validated6"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "description": "Optimistic command revision at the watermark.",
          "$ref": "#/$defs/Counter"
        },
        "session": {
          "description": "Authorized session metadata.",
          "$ref": "#/$defs/Validated5"
        }
      },
      "additionalProperties": false,
      "required": [
        "session",
        "cursor",
        "revision",
        "pending_questions"
      ]
    },
    "Counter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Canonical decimal u64; semantic validation also enforces u64 maximum.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "ExecutionState": {
      "description": "Assignment and worker streaming lifecycle; disconnect is not a transition.",
      "oneOf": [
        {
          "description": "Waiting for a fenced dispatch claim.",
          "type": "string",
          "const": "queued"
        },
        {
          "description": "Actively executing.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Durable question or approval is pending.",
          "type": "string",
          "const": "waiting_for_human"
        },
        {
          "description": "Capacity unavailable; no model fallback.",
          "type": "string",
          "const": "waiting_for_resources"
        },
        {
          "description": "Paused at a controllable boundary.",
          "type": "string",
          "const": "paused"
        },
        {
          "description": "Stop requested; execution may still be active.",
          "type": "string",
          "const": "cancellation_requested"
        },
        {
          "description": "Owned execution confirmed stopped.",
          "type": "string",
          "const": "terminated"
        },
        {
          "description": "Successful operation completion persisted.",
          "type": "string",
          "const": "completed"
        },
        {
          "description": "Failure recorded; surviving work must be reconciled.",
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "InferenceId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom InferenceId value.",
      "type": "string",
      "minLength": 1
    },
    "ItemId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ItemId value.",
      "type": "string",
      "minLength": 1
    },
    "ModelProfileId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ModelProfileId value.",
      "type": "string",
      "minLength": 1
    },
    "OperatorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom OperatorId value.",
      "type": "string",
      "minLength": 1
    },
    "PendingQuestionData": {
      "description": "Unchecked construction draft for `PendingQuestion`; validate before use.",
      "type": "object",
      "properties": {
        "allow_multiple": {
          "description": "True permits more than one selected choice.",
          "type": "boolean"
        },
        "allow_text": {
          "description": "True permits a nonblank free-text response, with or without selected choices.",
          "type": "boolean"
        },
        "assignment_id": {
          "description": "Original assignment.",
          "$ref": "#/$defs/AssignmentId"
        },
        "choices": {
          "description": "Allowed persisted choices.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorId"
          }
        },
        "conversation_id": {
          "description": "Source authorized conversation.",
          "$ref": "#/$defs/ConversationId"
        },
        "item_id": {
          "description": "Owning item.",
          "$ref": "#/$defs/ItemId"
        },
        "question_id": {
          "description": "Stable pending request identity.",
          "$ref": "#/$defs/QuestionId"
        },
        "resolved_by": {
          "description": "Durable resolution, absent while pending.",
          "anyOf": [
            {
              "$ref": "#/$defs/AnswerId"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "description": "Reject stale answers.",
          "$ref": "#/$defs/Counter"
        },
        "text": {
          "description": "Original operator question wording.",
          "type": "string"
        },
        "turn_id": {
          "description": "Owning turn.",
          "$ref": "#/$defs/TurnId"
        }
      },
      "additionalProperties": false,
      "required": [
        "question_id",
        "assignment_id",
        "conversation_id",
        "turn_id",
        "item_id",
        "revision",
        "text",
        "choices",
        "allow_multiple",
        "allow_text"
      ]
    },
    "PlanApprovalData": {
      "description": "Unchecked construction draft for `PlanApproval`; validate before use.",
      "type": "object",
      "properties": {
        "approved_by": {
          "description": "Authenticated approver; recheck grant on dispatch.",
          "$ref": "#/$defs/OperatorId"
        },
        "content_hash": {
          "description": "Hash of approved scope and permissions.",
          "$ref": "#/$defs/ActorId"
        },
        "plan_id": {
          "description": "Approved plan.",
          "$ref": "#/$defs/PlanId"
        },
        "revision": {
          "description": "Exact revision.",
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "plan_id",
        "revision",
        "content_hash",
        "approved_by"
      ]
    },
    "PlanId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom PlanId value.",
      "type": "string",
      "minLength": 1
    },
    "PlanRevisionData": {
      "description": "Unchecked construction draft for `PlanRevision`; validate before use.",
      "type": "object",
      "properties": {
        "acceptance_criteria": {
          "description": "Content-specific validation expectations.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_permissions": {
          "description": "Explicit versioned operation scope, checked by policy.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorId"
          }
        },
        "assumptions": {
          "description": "Visible unanswered assumptions.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content_hash": {
          "description": "Canonical hash including model assignments and permissions.",
          "$ref": "#/$defs/ActorId"
        },
        "model_assignments": {
          "description": "Human-selected configured role profiles.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelProfileId"
          }
        },
        "plan_id": {
          "description": "Stable plan identity.",
          "$ref": "#/$defs/PlanId"
        },
        "project_id": {
          "description": "Authority scope.",
          "$ref": "#/$defs/ProjectId"
        },
        "revision": {
          "description": "Specific immutable revision.",
          "$ref": "#/$defs/Counter"
        },
        "scope": {
          "description": "Human-readable approved work scope.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "plan_id",
        "revision",
        "project_id",
        "scope",
        "assumptions",
        "acceptance_criteria",
        "content_hash",
        "model_assignments",
        "allowed_permissions"
      ]
    },
    "ProjectId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ProjectId value.",
      "type": "string",
      "minLength": 1
    },
    "QuestionId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom QuestionId value.",
      "type": "string",
      "minLength": 1
    },
    "ReplayCursorData": {
      "description": "Unchecked construction draft for `ReplayCursor`; validate before use.",
      "type": "object",
      "properties": {
        "conversation_id": {
          "description": "Stream scope; cursor cannot grant access.",
          "$ref": "#/$defs/ConversationId"
        },
        "sequence": {
          "description": "Persisted monotonically increasing sequence; zero requests from start.",
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "sequence"
      ]
    },
    "ServiceEventData": {
      "description": "Unchecked construction draft for `ServiceEvent`; validate before use.",
      "type": "object",
      "properties": {
        "command_id": {
          "description": "Origin command identity.",
          "$ref": "#/$defs/CommandId"
        },
        "cursor": {
          "description": "Durable SSE id and native reconnect position.",
          "$ref": "#/$defs/Validated"
        },
        "event": {
          "description": "Normalized streamed output.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validated2"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "description": "Authorization scope.",
          "$ref": "#/$defs/ProjectId"
        },
        "snapshot": {
          "description": "Non-worker state update at this exact durable watermark; no invented execution identity.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validated4"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "cursor",
        "command_id",
        "project_id"
      ]
    },
    "SessionSummaryData": {
      "description": "Unchecked construction draft for `SessionSummary`; validate before use.",
      "type": "object",
      "properties": {
        "active_turn_id": {
          "description": "Current turn for steering.",
          "anyOf": [
            {
              "$ref": "#/$defs/TurnId"
            },
            {
              "type": "null"
            }
          ]
        },
        "archived": {
          "description": "Archive state.",
          "type": "boolean"
        },
        "conversation_id": {
          "description": "Stable conversation identity.",
          "$ref": "#/$defs/ConversationId"
        },
        "last_human_interaction_ms": {
          "description": "Background work does not reorder dashboard.",
          "$ref": "#/$defs/Counter"
        },
        "project_id": {
          "description": "Current access scope.",
          "$ref": "#/$defs/ProjectId"
        }
      },
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "project_id",
        "archived",
        "last_human_interaction_ms"
      ]
    },
    "StreamKind": {
      "description": "Normalized provider, engine and command streaming payload kind.",
      "oneOf": [
        {
          "description": "Operation/turn began.",
          "type": "string",
          "const": "started"
        },
        {
          "description": "Operation completed, independent of stream EOF.",
          "type": "string",
          "const": "completed"
        },
        {
          "description": "Terminal operation failure.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Pending human question or approval.",
          "type": "string",
          "const": "waiting_for_human"
        },
        {
          "description": "Incremental inference output.",
          "type": "string",
          "const": "text_delta"
        },
        {
          "description": "Incremental arguments; never execute until complete and validated.",
          "type": "string",
          "const": "tool_arguments_delta"
        },
        {
          "description": "Complete tool call; gateway independently checks authority.",
          "type": "string",
          "const": "tool_ready"
        },
        {
          "description": "Bounded command stdout chunk.",
          "type": "string",
          "const": "stdout"
        },
        {
          "description": "Bounded command stderr chunk.",
          "type": "string",
          "const": "stderr"
        },
        {
          "description": "Worker progress.",
          "type": "string",
          "const": "progress"
        },
        {
          "description": "Incremental durable accounting update.",
          "type": "string",
          "const": "usage"
        },
        {
          "description": "Persisted execution transition.",
          "type": "string",
          "const": "state_changed"
        },
        {
          "description": "Owned process/request stopped; distinct from cancel request.",
          "type": "string",
          "const": "termination_confirmed"
        }
      ]
    },
    "ToolCallId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ToolCallId value.",
      "type": "string",
      "minLength": 1
    },
    "TurnId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom TurnId value.",
      "type": "string",
      "minLength": 1
    },
    "UsageBasis": {
      "description": "Durable accounting precision.",
      "oneOf": [
        {
          "description": "Provider or engine counters.",
          "type": "string",
          "const": "reported"
        },
        {
          "description": "Deterministic estimate with an explicit basis.",
          "type": "string",
          "const": "estimated"
        },
        {
          "description": "Interrupted or unavailable counters; never treated as zero.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "UsageData": {
      "description": "Unchecked construction draft for `Usage`; validate before use.",
      "type": "object",
      "properties": {
        "basis": {
          "description": "Precision of measurement.",
          "$ref": "#/$defs/UsageBasis"
        },
        "billing": {
          "description": "Configured billing mode.",
          "$ref": "#/$defs/BillingMode"
        },
        "cached_tokens": {
          "description": "Reported cache usage where available.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "calculation_basis": {
          "description": "Rate/version or local estimate basis.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_micros": {
          "description": "Optional cost in currency millionths.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "description": "Explicit currency when cost is present.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "inference_id": {
          "description": "Idempotent request accounting key.",
          "$ref": "#/$defs/InferenceId"
        },
        "input_tokens": {
          "description": "Absent when unknown.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "description": "Absent when unknown.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "inference_id",
        "basis",
        "billing"
      ]
    },
    "Validated": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/ReplayCursorData"
    },
    "Validated2": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/WorkerEventData"
    },
    "Validated3": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/UsageData"
    },
    "Validated4": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/ConversationSnapshotData"
    },
    "Validated5": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/SessionSummaryData"
    },
    "Validated6": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/PlanRevisionData"
    },
    "Validated7": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/PlanApprovalData"
    },
    "Validated8": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/PendingQuestionData"
    },
    "Validated9": {
      "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
      "$ref": "#/$defs/BudgetData"
    },
    "WorkerEventData": {
      "description": "Unchecked construction draft for `WorkerEvent`; validate before use.",
      "type": "object",
      "properties": {
        "assignment_id": {
          "description": "Owning assignment.",
          "$ref": "#/$defs/AssignmentId"
        },
        "inference_id": {
          "description": "Present for inference output.",
          "anyOf": [
            {
              "$ref": "#/$defs/InferenceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_id": {
          "description": "Stable stream item identity.",
          "$ref": "#/$defs/ItemId"
        },
        "kind": {
          "description": "Normalized event kind.",
          "$ref": "#/$defs/StreamKind"
        },
        "state": {
          "description": "Present exactly for state events.",
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionState"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "description": "Bounded output chunk; no credentials.",
          "type": "string"
        },
        "tool_call_id": {
          "description": "Present for complete or partial tool calls.",
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallId"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_id": {
          "description": "Stable active turn.",
          "$ref": "#/$defs/TurnId"
        },
        "usage": {
          "description": "Typed reported, estimated or unknown counters.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validated3"
            },
            {
              "type": "null"
            }
          ]
        },
        "worker_id": {
          "description": "Worker identity.",
          "$ref": "#/$defs/WorkerId"
        }
      },
      "additionalProperties": false,
      "required": [
        "worker_id",
        "turn_id",
        "item_id",
        "assignment_id",
        "kind",
        "text"
      ]
    },
    "WorkerId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom WorkerId value.",
      "type": "string",
      "minLength": 1
    }
  }
}
