{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated",
  "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
  "$ref": "#/$defs/LessonQueryData",
  "$defs": {
    "AssignmentId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom AssignmentId value.",
      "type": "string",
      "minLength": 1
    },
    "Counter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Canonical decimal u64; semantic validation also enforces u64 maximum.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "LessonId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom LessonId value.",
      "type": "string",
      "minLength": 1
    },
    "LessonQueryData": {
      "description": "Unchecked construction draft for `LessonQuery`; validate before use.",
      "type": "object",
      "properties": {
        "after": {
          "description": "Exclusive stable lesson cursor.",
          "anyOf": [
            {
              "$ref": "#/$defs/LessonId"
            },
            {
              "type": "null"
            }
          ]
        },
        "assignment_id": {
          "description": "Optional authorized assignment scope.",
          "anyOf": [
            {
              "$ref": "#/$defs/AssignmentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "description": "Bounded page size.",
          "$ref": "#/$defs/Counter"
        },
        "project_id": {
          "description": "Authorized project including its applicable shared lessons.",
          "$ref": "#/$defs/ProjectId"
        },
        "scope": {
          "description": "Optional current-scope filter.",
          "anyOf": [
            {
              "$ref": "#/$defs/RecordScope"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "limit"
      ]
    },
    "ProjectId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ProjectId value.",
      "type": "string",
      "minLength": 1
    },
    "RecordScope": {
      "description": "Stored scope; similarity and shared lessons are never approval.",
      "oneOf": [
        {
          "description": "Restricted to the origin assignment.",
          "type": "string",
          "const": "assignment"
        },
        {
          "description": "Available in the origin project.",
          "type": "string",
          "const": "project"
        },
        {
          "description": "Explicitly shared content; source access is still checked separately.",
          "type": "string",
          "const": "installation"
        }
      ]
    }
  }
}
