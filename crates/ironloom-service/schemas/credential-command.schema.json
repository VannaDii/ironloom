{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated",
  "description": "A validated immutable model; no mutable dereference or unchecked constructor.",
  "$ref": "#/$defs/CredentialCommandData",
  "$defs": {
    "ActorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom ActorId value.",
      "type": "string",
      "minLength": 1
    },
    "CommandId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom CommandId value.",
      "type": "string",
      "minLength": 1
    },
    "Counter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Canonical decimal u64; semantic validation also enforces u64 maximum.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "CredentialCommandData": {
      "description": "Unchecked construction draft for `CredentialCommand`; validate before use.",
      "type": "object",
      "properties": {
        "command_id": {
          "description": "Durable actor-scoped mutation identity.",
          "$ref": "#/$defs/CommandId"
        },
        "credential_id": {
          "description": "None only for creation; server assigns identity.",
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialId"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_revision": {
          "description": "Zero only for creation, positive for existing records.",
          "$ref": "#/$defs/Counter"
        },
        "grantee": {
          "description": "Required only for share/revoke.",
          "anyOf": [
            {
              "$ref": "#/$defs/OperatorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "description": "Required for creation; optional on replacement.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "description": "Explicit management operation.",
          "$ref": "#/$defs/CredentialOperation"
        },
        "permissions": {
          "description": "Share grants limited to credential operations.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Permission"
          }
        },
        "revoke": {
          "description": "True only for revoking a specified share.",
          "type": "boolean"
        },
        "secret": {
          "description": "Required only for create/replace, never emitted by read APIs.",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretInput"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "command_id",
        "expected_revision",
        "operation",
        "permissions",
        "revoke"
      ]
    },
    "CredentialId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom CredentialId value.",
      "type": "string",
      "minLength": 1
    },
    "CredentialOperation": {
      "description": "Credential management, independent from session login or inference billing.",
      "oneOf": [
        {
          "description": "Create a private credential owned by authenticated operator.",
          "type": "string",
          "const": "create"
        },
        {
          "description": "Replace secret material with distinct permission.",
          "type": "string",
          "const": "replace"
        },
        {
          "description": "Grant/revoke explicit per-operation authority.",
          "type": "string",
          "const": "share"
        },
        {
          "description": "Delete secret material with distinct permission.",
          "type": "string",
          "const": "delete"
        }
      ]
    },
    "OperatorId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "description": "Validated Ironloom OperatorId value.",
      "type": "string",
      "minLength": 1
    },
    "Permission": {
      "description": "Resource grant; administrator identity alone grants no project content access.",
      "oneOf": [
        {
          "description": "Read approved resource content.",
          "type": "string",
          "const": "view"
        },
        {
          "description": "Dispatch within approved scope.",
          "type": "string",
          "const": "operate"
        },
        {
          "description": "Approve a plan revision.",
          "type": "string",
          "const": "approve"
        },
        {
          "description": "Manage membership or content.",
          "type": "string",
          "const": "manage"
        },
        {
          "description": "Broaden visibility explicitly.",
          "type": "string",
          "const": "share"
        },
        {
          "description": "Use through a trusted adapter.",
          "type": "string",
          "const": "use_credential"
        },
        {
          "description": "Replace secret material.",
          "type": "string",
          "const": "replace_credential"
        },
        {
          "description": "Delete secret material.",
          "type": "string",
          "const": "delete_credential"
        },
        {
          "description": "Enroll another service node.",
          "type": "string",
          "const": "enroll_node"
        },
        {
          "description": "Record administrator access to a private project.",
          "type": "string",
          "const": "self_grant"
        }
      ]
    },
    "SecretInput": {
      "description": "Secret submitted only to the authentication backend; Debug is always redacted.",
      "type": "string"
    }
  }
}
